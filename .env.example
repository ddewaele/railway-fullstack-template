# Copy to .env for local development. Railway injects these in production.

# Server
PORT=3000
NODE_ENV=development
# Public URL of the app (used for OAuth redirect URI and cookie settings)
APP_URL=http://localhost:5173

# Database (docker-compose default)
DATABASE_URL=postgres://app:app@localhost:5433/app

# Google OAuth 2.0 client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random 32+ char string. Generate: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
