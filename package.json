{
  "name": "railway-fullstack-template",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Vite + Hono + Postgres + Google SSO template, deployed on Railway",
  "license": "MIT",
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @repo/server dev\" \"pnpm --filter @repo/web dev\"",
    "build": "pnpm -r build",
    "start": "node apps/server/dist/index.js",
    "db:migrate": "pnpm --filter @repo/server db:migrate",
    "db:generate": "pnpm --filter @repo/server db:generate",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
